{
  "name": "8thwall-test3-book-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "webpack --config config/webpack.config.js",
    "serve": "webpack-dev-server --mode=development --config config/webpack.config.js",
    "serve:phone": "WEBPACK_SERVE_NO_CLIENT=1 webpack-dev-server --mode=development --config config/webpack.config.js",
    "serve:http": "WEBPACK_SERVE_HTTP=1 webpack-dev-server --mode=development --config config/webpack.config.js",
    "generate-cert": "openssl req -x509 -newkey rsa:2048 -keyout localhost-key.pem -out localhost.pem -days 365 -nodes -subj '/CN=localhost'",
    "make-target": "python3 scripts/make-target.py"
  },
  "devDependencies": {
    "@babel/parser": "^7.23.9",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.23.9",
    "@babel/runtime": "^7.28.4",
    "@types/node": "^16.18.36",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "extract-loader": "^5.1.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.5",
    "sass": "^1.94.2",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "ts-essentials": "^9.3.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "description": "Book cover portal: spheres fly out of a tracked book cover and fall/bounce under gravity (8th Wall image targets + world tracking).",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
